<!DOCTYPE html>
<html>
<head>
    <title>Dinosaur Quiz</title>
</head>
<body>

    <h1>Dinosaur Multiple Choice Quiz</h1>
   
    <hr>

    <form>
        <h2>Spinosaurus Questions</h2>

        <p><b>1. What time period did the Spinosaurus live in?</b></p>
        <input type="radio" id="q1a" name="q1" value="A">
        <label for="q1a">A) Late Jurassic period</label><br>
        <input type="radio" id="q1b" name="q1" value="B">
        <label for="q1b">B) Cretaceous period</label><br>
        <input type="radio" id="q1c" name="q1" value="C">
        <label for="q1c">C) Triassic period</label><br>
        <input type="radio" id="q1d" name="q1" value="D">
        <label for="q1d">D) Permian period</label><br>

        <p><b>2. What distinctive feature runs along the back of a Spinosaurus?</b></p>
        <input type="radio" id="q2a" name="q2" value="A">
        <label for="q2a">A) Heavy spiked tail clubs</label><br>
        <input type="radio" id="q2b" name="q2" value="B">
        <label for="q2b">B) A tall sail-like structure made of neural spines</label><br>
        <input type="radio" id="q2c" name="q2" value="C">
        <label for="q2c">C) Dual rows of diamond plates</label><br>
        <input type="radio" id="q2d" name="q2" value="D">
        <label for="q2d">D) Thick defensive armor shell</label><br>

        <p><b>3. What type of lifestyle was the Spinosaurus specialized for?</b></p>
        <input type="radio" id="q3a" name="q3" value="A">
        <label for="q3a">A) Semi-aquatic predator hunting fish</label><br>
        <input type="radio" id="q3b" name="q3" value="B">
        <label for="q3b">B) High-canopy tree climber</label><br>
        <input type="radio" id="q3c" name="q3" value="C">
        <label for="q3c">C) Burrowing underground</label><br>
        <input type="radio" id="q3d" name="q3" value="D">
        <label for="q3d">D) Desert pack hunter</label><br>

        <hr>

        <h2>Ceratosaurus Questions</h2>

        <p><b>4. What unique feature is located on the snout of a Ceratosaurus?</b></p>
        <input type="radio" id="q4a" name="q4" value="A">
        <label for="q4a">A) A prominent, blade-shaped horn</label><br>
        <input type="radio" id="q4b" name="q4" value="B">
        <label for="q4b">B) A wide duck-like beak</label><br>
        <input type="radio" id="q4c" name="q4" value="C">
        <label for="q4c">C) Long curved tusks</label><br>
        <input type="radio" id="q4d" name="q4" value="D">
        <label for="q4d">D) Three hollow crest horns</label><br>

        <p><b>5. Around what time period did the Ceratosaurus exist?</b></p>
        <input type="radio" id="q5a" name="q5" value="A">
        <label for="q5a">A) Early Triassic</label><br>
        <input type="radio" id="q5b" name="q5" value="B">
        <label for="q5b">B) Late Jurassic</label><br>
        <input type="radio" id="q5c" name="q5" value="C">
        <label for="q5c">C) Late Cretaceous</label><br>
        <input type="radio" id="q5d" name="q5" value="D">
        <label for="q5d">D) Pleistocene</label><br>

        <p><b>6. What kind of predator was the Ceratosaurus classified as?</b></p>
        <input type="radio" id="q6a" name="q6" value="A">
        <label for="q6a">A) Ocean apex swimmer</label><br>
        <input type="radio" id="q6b" name="q6" value="B">
        <label for="q6b">B) Medium-sized terrestrial hunter</label><br>
        <input type="radio" id="q6c" name="q6" value="C">
        <label for="q6c">C) Strictly an herbivore</label><br>
        <input type="radio" id="q6d" name="q6" value="D">
        <label for="q6d">D) Gliding predator</label><br>

        <br>
        <input type="submit" value="Submit Answers">
    </form>
<!-- This empty h2 tag is where the JavaScript will print the final score -->
    <h2 id="resultDisplay"></h2>

    <script>
        document.getElementById("quizForm").onsubmit = function(event) {
            
            event.preventDefault();

            let score = 0;

            
            let ans1 = document.querySelector('input[name="q1"]:checked');
            let ans2 = document.querySelector('input[name="q2"]:checked');
            let ans3 = document.querySelector('input[name="q3"]:checked');
            let ans4 = document.querySelector('input[name="q4"]:checked');
            let ans5 = document.querySelector('input[name="q5"]:checked');
            let ans6 = document.querySelector('input[name="q6"]:checked');

            
            if (ans1 && ans1.value === "B") { score++; }
            if (ans2 && ans2.value === "B") { score++; }
            if (ans3 && ans3.value === "A") { score++; }
            if (ans4 && ans4.value === "A") { score++; }
            if (ans5 && ans5.value === "B") { score++; }
            if (ans6 && ans6.value === "B") { score++; }

            // Calculate percentage
            let percentage = Math.round((score / 6) * 100);

            
            document.getElementById("resultDisplay").innerHTML = "You scored " + percentage + "% (" + score + " out of 6 correct)!";
        };
    </script>
</body>
</html>
